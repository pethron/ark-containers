{
  "name": "ark-containers",
  "version": "0.0.0",
  "private": true,
  "engines": {"node": ">=20"},
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "start": "npm run stage && docusaurus start --host 127.0.0.1 --no-open",
    "build": "npm run stage && docusaurus build && node scripts/verify-site.mjs",
    "serve": "docusaurus serve --host 127.0.0.1 --port 4173 --no-open",
    "test": "node --test scripts/site.test.mjs scripts/test_terminal.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
